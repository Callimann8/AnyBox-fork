set(ANYBOX_XDLL_ROOT ${CMAKE_SOURCE_DIR}/core/libs/xdll)
file(GLOB ANYBOX_XDLL_IMPORT_FILES CONFIGURE_DEPENDS ${ANYBOX_XDLL_ROOT}/*/Imports.txt)
list(SORT ANYBOX_XDLL_IMPORT_FILES)

set(ANYBOX_LIBRARY_NAMES "")
set(route_lines "")
set(map_lines "")
foreach(imports_file IN LISTS ANYBOX_XDLL_IMPORT_FILES)
    get_filename_component(library_dir ${imports_file} DIRECTORY)
    get_filename_component(library ${library_dir} NAME)
    list(APPEND ANYBOX_LIBRARY_NAMES ${library})
    file(STRINGS ${imports_file} patterns)
    foreach(pattern IN LISTS patterns)
        string(STRIP "${pattern}" pattern)
        string(TOLOWER "${pattern}" pattern)
        if(pattern STREQUAL "")
            continue()
        endif()
        if(NOT pattern MATCHES "^[a-z0-9_.*-]+$")
            message(FATAL_ERROR "${imports_file}: '${pattern}' is not a DLL name pattern")
        endif()
        string(APPEND route_lines "    {\"${pattern}\", \"ab_${library}.dll\", \"${library}\"},\n")
        string(APPEND map_lines "${pattern}\tab_${library}.dll\t${library}\n")
    endforeach()
endforeach()

file(STRINGS ${CMAKE_SOURCE_DIR}/core/relinker/HostDlls.txt host_patterns)
set(host_lines "")
foreach(pattern IN LISTS host_patterns)
    string(STRIP "${pattern}" pattern)
    string(TOLOWER "${pattern}" pattern)
    if(pattern STREQUAL "")
        continue()
    endif()
    string(APPEND host_lines "    \"${pattern}\",\n")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/core/relinker/HostDlls.txt)

file(CONFIGURE OUTPUT ${ANYBOX_GENERATED_DIR}/LibraryMapData.inc CONTENT "${route_lines}")
file(CONFIGURE OUTPUT ${ANYBOX_GENERATED_DIR}/HostDllsData.inc CONTENT "${host_lines}")
file(CONFIGURE OUTPUT ${ANYBOX_LIBS_DIR}/anybox-libs.map CONTENT "${map_lines}")
